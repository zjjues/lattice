# 复制为 .env.local 后填写你的本地 Dify 配置
export DIFY_BASE_URL=http://localhost
export DIFY_API_KEY=replace_with_your_dify_api_key
export DIFY_APP_MODE=workflow
export DIFY_USER=fake-lattice-local

# Embedding RAG：大型数据库和模型建议放在 D 盘
export RAG_DATA_DIR=/mnt/d/lattice-data/rag
export EMBEDDING_BASE_URL=http://127.0.0.1:模型服务端口/v1
export EMBEDDING_API_KEY=replace_with_embedding_api_key
export EMBEDDING_MODEL=replace_with_embedding_model
export EMBEDDING_DIMENSION=1024
